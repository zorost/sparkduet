# ============================================================================
# SparkDuet cluster configuration, copy to ./sparkduet.env and edit.
# All numeric knobs are validated (decimal integers only) before use.
# Never commit sparkduet.env: it carries your cluster's addresses.
# ============================================================================

# ---- Cluster wiring (required) --------------------------------------------
# The two Sparks talk NCCL over the direct 200G QSFP link. Use the fabric IPs
# (ip -br addr on the QSFP interfaces), NOT your LAN or WiFi addresses.
MASTER_ADDR=10.0.0.1              # head node IP on the RoCE fabric
MASTER_PORT=29601                 # NCCL/torch rendezvous port
WORKER_FABRIC_IP=10.0.0.2         # worker node IP on the RoCE fabric
WORKER_HOST=10.0.0.2              # address ssh uses to reach the worker
WORKER_USER=spark                 # ssh user on the worker
NCCL_IB_HCA=rocep1s0f1            # RDMA device(s), comma-separated (ibdev2netdev).
                                  # DGX Spark pairs cabled on BOTH QSFP ports run
                                  # dual-rail: rocep1s0f1,roceP2p1s0f1
NCCL_SOCKET_IFNAME=enp1s0f1np1    # QSFP interface(s) for NCCL bootstrap. Pinning
                                  # this is mandatory: unpinned collectives fall
                                  # back to WiFi at 1/10th speed with no error.
                                  # Dual-rail: enp1s0f1np1,enP2p1s0f1np1
NCCL_IB_GID_INDEX=3               # RoCEv2 GID (3 typical on Spark direct link)
GLOO_SOCKET_IFNAME=enp1s0f1np1    # ONE rail only, same subnet as MASTER_ADDR
                                  # (torch's Gloo rendezvous cannot span rails)

# ---- Paths ------------------------------------------------------------------
HF_CACHE=/srv/ai/cache/huggingface        # HF cache on the head
WORKER_HF_CACHE=/srv/ai/cache/huggingface # HF cache on the worker
MODEL_DIR=/srv/ai/models/llm              # local weights root (mounted read-only)
SPARKDUET_DIR=/srv/ai/sparkduet           # where this repo lives on both nodes

# ---- Images (pin by digest in production) ---------------------------------
VLLM_IMAGE=ghcr.io/anemll/dspark-vllm-gx10:0.1.1
FINETUNE_IMAGE=unsloth/unsloth:dgxspark-latest   # NVIDIA/Unsloth build for GB10
FINETUNE_OUTPUT_DIR=/srv/ai/finetune             # adapters and merged models land here

# ---- Models ---------------------------------------------------------------
# DS_MODEL accepts a HF repo id (uses the cache; pin DS_REVISION) or an absolute
# path under MODEL_DIR for fully offline serving (recommended once staged).
DS_MODEL=/srv/ai/models/llm/DeepSeek-V4-Flash-0731
DS_REVISION=9e165c30e2704aec5d9d593cce3eebd58bbef1cb
DS_SERVED_NAME=deepseek-ai/DeepSeek-V4-Flash-0731
QWEN_MODEL=Qwen/Qwen3.8-27B
QWEN_REVISION=                    # pin after first validated boot
QWEN_SERVED_NAME=sparkduet-qwen38-27b
HF_HUB_OFFLINE=1                  # 1 after caches are warm on BOTH nodes

# ---- Lane D (depth: TP=2 across both nodes) ---------------------------------
# The full FP8 checkpoint is ~156 GiB on disk: it does NOT fit one 128 GB node.
# TP=2 loads ~79 GiB per node. Budget the rest between KV pool and whatever else
# the node runs. 0.835 is the max-performance figure from the reference recipe;
# lower it if the nodes also host other services (see docs/ARCHITECTURE.md §3).
D_HOST=127.0.0.1                  # bind loopback; put your own gateway in front
D_PORT=30000
D_MAX_MODEL_LEN=1048576           # 1M ceiling
D_MAX_NUM_SEQS=6
D_MAX_NUM_BATCHED_TOKENS=8192
D_LONG_PREFILL_TOKEN_THRESHOLD=1024
D_GPU_MEM_UTIL=0.75               # 0.835 for a dedicated pair; 0.72–0.78 shared
                                  # measured: every 0.01 here is ~1.2 GiB of KV;
                                  # at 0.72 the pool held 148K tokens (1.13 full-ctx reqs)
VLLM_CACHE_DIR=/srv/ai/cache/vllm # persisted JIT/autotune cache (fast restarts)
D_MTP_NUM_TOKENS=5                # static default; see specadvisor.py to tune
D_KV_DTYPE=nvfp4_ds_mla           # capacity lever, not a speed lever

# ---- Lane F (fleet: one full replica per node) ------------------------------
# Lane F requires the model to FIT ON ONE NODE. That means the Qwen profile
# (dense 27B) or a quantized DeepSeek build, never the official FP8 checkpoint.
F_MODEL=qwen                      # qwen | path to a <=90 GiB checkpoint
F_MAX_MODEL_LEN=262144
F_MAX_NUM_SEQS=4                  # per replica
F_GPU_MEM_UTIL=0.80
F_MTP_NUM_TOKENS=0                # 0 = no speculation (Qwen MTP optional)
F_KV_DTYPE=auto
F_PORT_A=30010                    # replica on head
F_PORT_B=30010                    # replica on worker

# ---- Lane P (split: prefill/decode disaggregation, experimental) -----------
P_PROMPT_THRESHOLD=8192
P_MAX_MODEL_LEN=1048576
P_DECODE_MAX_NUM_SEQS=8
P_GPU_MEM_UTIL_DECODE=0.85
P_GPU_MEM_UTIL_PREFILL=0.80
P_MTP_NUM_TOKENS=5
P_DECODE_PORT=30020
P_PREFILL_PORT=30021

# ---- Router (OPTIONAL, only needed when running more than one lane) --------
# Daily single-lane serving does not need the router: clients hit D_PORT
# directly and streaming works natively. Start it with `sparkduetctl.sh router`.
ROUTER_ENABLE=0
ROUTER_HOST=127.0.0.1
ROUTER_PORT=30008
LANE_DEFAULT=depth                # depth|fleet|split
LANE_FLEET_ENABLE=0               # 1 → depth overflow spills to fleet
LANE_SPLIT_ENABLE=0               # 1 → long prompts route to the split lane
LANE_MAX_INFLIGHT=32              # typed 429 beyond this, per lane
D_HIGH_WATER_SEQS=5               # spill short requests to F beyond this

# ---- SpecAdvisor -------------------------------------------------------------
SPEC_WINDOW_S=300
SPEC_K_SET=3,5,7                  # capture limit: MAX_NUM_SEQS*(k+1) <= 48
SPEC_MIN_DRAFT_TOKENS=2000        # skip windows with less speculative traffic

# ---- Safety ------------------------------------------------------------------
VLLM_USE_BREAKABLE_CUDAGRAPH=0    # keep 0 (regular graphs measured +13–28%)
